# Copy to .env for local development. Never commit real secrets.
# Payments stay disabled until legal review and PayPal approval are complete.
PAYPAL_ENABLED=false
# Only "sandbox" can be enabled. Live PayPal is refused by src/lib/payment-config.ts.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Email uses Gmail SMTP and stays off until both values are set.
# GMAIL_APP_PASSWORD is a 16-character Google app password (needs 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Set after creating the sandbox webhook in the PayPal developer dashboard.
PAYPAL_WEBHOOK_ID=
# Public origin of the site, used for PayPal return and cancel links.
# Netlify sets URL automatically; set SITE_URL only to override it.
SITE_URL=
